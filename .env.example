# Copy to .env and fill in. Never commit .env.
# Every secret and connection string lives here, so a later move from
# Supabase and Railway to AWS is a change of values, not of code.

# --- Database (Supabase Postgres now, RDS or Azure later) ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.example.supabase.co:5432/postgres

# Supabase project (needed for Auth). The service role key bypasses row-level
# security: use it only in the agent and MCP services, never in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# --- Model access (Amazon Bedrock, your own AWS account) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Chosen later from the test-set comparison; leave blank until then.
BEDROCK_MODEL_ID=

# --- Agent behaviour ---
# Free tier: messages per registered user (also stored per user in profiles.message_limit).
FREE_TIER_MESSAGE_LIMIT=4
# A conversation expires after this many hours of inactivity.
SESSION_TTL_HOURS=24
# Per-turn safety caps to bound cost.
MAX_TOOL_CALLS_PER_TURN=6
MAX_OUTPUT_TOKENS=1500
# Tier 1: lowest similarity for a verified query to be offered as a candidate (the model decides).
VERIFIED_QUERY_FLOOR=0.15
# How long the cached semantic layer (measures and filters) is reused before reloading.
SEMANTIC_LAYER_TTL_SECONDS=3600

# --- Agent API ---
# Used to verify the Supabase access token sent by the frontend.
SUPABASE_JWT_SECRET=CHANGE_ME
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# true = stream canned responses (no Bedrock, no database writes) so the UI can be built first.
MOCK_AGENT=false

# --- MCP server ---
MCP_SERVER_URL=http://localhost:8001/mcp
# Phase one: false. The MCP server is not exposed publicly; the agent calls the catalog in-process.
MCP_PUBLIC=false
# Required if MCP_PUBLIC is ever true (bearer token for the MCP HTTP endpoint).
MCP_API_KEY=
